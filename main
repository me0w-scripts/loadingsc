local HUES = { Color3.fromRGB(160, 68, 176), Color3.fromRGB(185, 42, 175), Color3.fromRGB(217, 196, 197), Color3.fromRGB(160, 56, 66), Color3.fromRGB(229, 195, 111), Color3.fromRGB(124, 30, 31), Color3.fromRGB(229, 90, 43), Color3.fromRGB(250, 151, 54) }

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local IS_TOUCH = UserInputService.TouchEnabled
local rnd = Random.new()

local function new(class, props, parent)
	local obj = Instance.new(class)
	for k, v in pairs(props) do
		obj[k] = v
	end
	obj.Parent = parent
	return obj
end

local function getParent()
	local ok, ui = pcall(function()
		return (gethui and gethui()) or game:GetService("CoreGui")
	end)
	if ok and ui then
		return ui
	end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local parent = getParent()
pcall(function()
	local old = parent:FindFirstChild(TITLE)
	if old then
		old:Destroy()
	end
end)

local Gui = new("ScreenGui", {
	Name = TITLE,
	IgnoreGuiInset = true,
	ResetOnSpawn = false,
	DisplayOrder = 999,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, parent)
pcall(function()
	Gui.ScreenInsets = Enum.ScreenInsets.None
end)
pcall(function()
	if syn and syn.protect_gui then
		syn.protect_gui(Gui)
	end
end)

-- ========== BACKDROP ==========
local Root = new("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(0, 0, 0),
	BorderSizePixel = 0,
	Active = true, -- blocks taps/clicks behind it
}, Gui)
local Backdrop = new("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(1, 1, 1),
	BorderSizePixel = 0,
}, Root)
new("UIGradient", {
	Rotation = 90,
	Color = ColorSequence.new(Color3.fromRGB(26, 8, 40), Color3.fromRGB(4, 2, 8)),
}, Backdrop)

local function circle(parentFrame, size, x, y, transp, color, scale)
	local c = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = scale and UDim2.fromScale(x, y) or UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = color,
		BackgroundTransparency = transp,
		BorderSizePixel = 0,
	}, parentFrame)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, c)
	return c
end
circle(Root, 190, 0.82, 0.16, 0.93, ORANGE, true)
circle(Root, 130, 0.82, 0.16, 0.88, ORANGE, true)
circle(Root, 78, 0.82, 0.16, 0.7, ORANGE_LIGHT, true)

local embers = {}
for i = 1, (IS_TOUCH and 10 or 22) do
	local size = rnd:NextInteger(2, 5)
	embers[i] = {
		frame = new("Frame", {
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = (i % 3 == 0) and ORANGE_LIGHT or ORANGE,
			BackgroundTransparency = rnd:NextNumber(0.3, 0.7),
			BorderSizePixel = 0,
		}, Root),
		x = rnd:NextNumber(),
		y = rnd:NextNumber(),
		speed = rnd:NextNumber(0.03, 0.1),
		phase = rnd:NextNumber(0, 6),
	}
end

local bats = {}
local function makeBat(y, speed, dir, startX)
	local c = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(26, 12),
		BackgroundTransparency = 1,
	}, Root)
	local col = Color3.fromRGB(12, 6, 20)
	new("Frame", { Position = UDim2.fromOffset(11, 2), Size = UDim2.fromOffset(4, 8), BackgroundColor3 = col, BorderSizePixel = 0 }, c)
	local wl = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromOffset(11, 6), Size = UDim2.fromOffset(12, 3), BackgroundColor3 = col, BorderSizePixel = 0 }, c)
	local wr = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromOffset(15, 6), Size = UDim2.fromOffset(12, 3), BackgroundColor3 = col, BorderSizePixel = 0 }, c)
	bats[#bats + 1] = { frame = c, wl = wl, wr = wr, x = startX, y = y, speed = speed, dir = dir, phase = rnd:NextNumber(0, 6) }
end
makeBat(0.14, 0.045, 1, 0.1)
makeBat(0.3, 0.03, -1, 0.7)
if not IS_TOUCH then
	makeBat(0.08, 0.06, 1, 0.5)
end

-- ========== CARD ==========
local Holder = new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.58),
	Size = UDim2.fromOffset(CARD_W, CARD_H),
	BackgroundTransparency = 1,
}, Root)

local Fit = new("UIScale", {}, Holder)
local function updateScale()
	local vp = Root.AbsoluteSize
	if vp.X < 2 or vp.Y < 2 then
		local cam = workspace.CurrentCamera
		vp = cam and cam.ViewportSize or Vector2.new(800, 600)
	end
	local margin = IS_TOUCH and 36 or 28
	Fit.Scale = math.clamp(math.min(vp.X / (CARD_W + margin), vp.Y / (CARD_H + margin)) * 0.8, 0.4, 0.85) -- compact size
end
updateScale()
Root:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateScale)
task.delay(0.3, updateScale) -- some executors report the size a moment late

local Card = new("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(1, 1, 1),
	BorderSizePixel = 0,
	ClipsDescendants = true,
}, Holder)
new("UICorner", { CornerRadius = UDim.new(0, 22) }, Card)
local CardStroke = new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 3 }, Card)
