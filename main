-- ========== INTRO ==========
TweenService:Create(Cover, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
TweenService:Create(
	Holder,
	TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
	{ Position = UDim2.fromScale(0.5, 0.5) }
):Play()
local function introText(label, stroke, delay)
	label.TextTransparency = 1
	stroke.Transparency = 1
	task.delay(delay, function()
		TweenService:Create(label, TweenInfo.new(0.4), { TextTransparency = 0 }):Play()
		TweenService:Create(stroke, TweenInfo.new(0.4), { Transparency = 0 }):Play()
	end)
end
introText(Grave, GraveStroke, 0.3)
introText(Title, TitleStroke, 0.45)
introText(Percent, PercentStroke, 0.6)

-- ========== LOGIC ==========
local messages = {
	"Gathering pieces",
	"Sorting the candy",
	"Waking the skeletons",
	"Carving pumpkins",
	"Polishing the pieces",
	"Feeding the bats",
	"Lighting the candles",
	"Scaring off the ghosts",
	"Wrapping the gifts",
	"Almost ready to give",
}

local elapsed, lastShown, lastStatus, finished = 0, -1, "", false
local nextSwap = rnd:NextNumber(0.5, 1.5)
local conn

conn = RunService.Heartbeat:Connect(function(dt)
	elapsed = elapsed + dt
	local p = math.clamp(elapsed / TOTAL_TIME, 0, 1)

	-- new picture after a random 0.5 - 1.5 seconds
	if elapsed >= nextSwap then
		nextSwap = elapsed + rnd:NextNumber(0.5, 1.5)
		showSlide(currentSlide % SLIDE_COUNT + 1)
	end
	haloFlash = math.max(0, haloFlash - dt * 4)

	local n = math.clamp(math.floor(1 + p * 98 + 0.5), 1, 99)
	if n ~= lastShown then
		lastShown = n
		Percent.Text = n .. "%"
	end
	Fill.Size = UDim2.new(math.max(p, 0.01), 0, 1, 0)
	Rider.Position = UDim2.fromOffset(BAR_X + math.clamp(p * BAR_W - 8, 0, BAR_W - 16), 290 + math.sin(elapsed * 5) * 1.5)

	local idx = math.clamp(math.floor(elapsed / (TOTAL_TIME / #messages)) + 1, 1, #messages)
	local st = messages[idx] .. string.rep(".", math.floor(elapsed * 2) % 4)
	if st ~= lastStatus then
		lastStatus = st
		Status.Text = st
	end

	Shine.Position = UDim2.new(((elapsed * 0.5) % 1.3) - 0.15, 0, 0, 0)
	StrokeGrad.Rotation = (elapsed * 70) % 360
	RingGrad.Rotation = (elapsed * 120) % 360
	Glow.BackgroundTransparency = 0.04 * math.sin(elapsed * 9) + 0.04 * math.sin(elapsed * 5.3)
	Grave.TextColor3 = ORANGE_LIGHT:Lerp(ORANGE, (math.sin(elapsed * 2.2) + 1) / 2 * 0.55)
	Halo.BackgroundTransparency = math.clamp(0.9 + math.sin(elapsed * 2) * 0.04 - haloFlash * 0.3, 0, 1)

	for k, o in ipairs(orbs) do
		local a = elapsed * 1.1 + (k - 1) * math.pi / 2
		o.Position = UDim2.fromOffset(CX + math.cos(a) * 76, CY + math.sin(a) * 76 + math.sin(elapsed * 2) * 3)
	end

	-- the picture floats and tilts a little
	Art.Rotation = math.sin(elapsed * 1.6) * 3
	Art.Position = UDim2.fromOffset(CX, CY + math.sin(elapsed * 2) * 3)

	for _, c in ipairs(confetti) do
		if c.alive then
			c.t = c.t + dt
			c.vy = c.vy + 150 * dt
			c.x = c.x + c.vx * dt
			c.y = c.y + c.vy * dt
			c.frame.Position = UDim2.fromOffset(c.x, c.y)
			c.frame.Rotation = c.rot + c.t * 300
			c.frame.BackgroundTransparency = math.clamp(c.t / c.max, 0, 1)
			if c.t >= c.max then
				c.alive = false
				c.frame.Visible = false
			end
		end
	end
	Ghost.Position = UDim2.fromOffset(CARD_W / 2 + math.sin(elapsed * 0.45) * 120, 220 + math.sin(elapsed * 0.9) * 12)

	for _, e in ipairs(embers) do
		e.y = e.y - e.speed * dt
		if e.y < -0.05 then
			e.y = 1.05
			e.x = rnd:NextNumber()
		end
		e.frame.Position = UDim2.fromScale(e.x + math.sin(elapsed * 0.8 + e.phase) * 0.012, e.y)
	end
	for _, b in ipairs(bats) do
		b.x = b.x + b.speed * dt * b.dir
		if b.x > 1.08 then
			b.x = -0.08
		elseif b.x < -0.08 then
			b.x = 1.08
		end
		b.frame.Position = UDim2.fromScale(b.x, b.y + math.sin(elapsed * 1.5 + b.phase) * 0.012)
		local flap = 10 + 28 * math.sin(elapsed * 14 + b.phase)
		b.wl.Rotation = flap
		b.wr.Rotation = -flap
	end

	if elapsed >= TOTAL_TIME and not finished then
		finished = true
		conn:Disconnect()
		Percent.Text = "100%"
		Fill.Size = UDim2.fromScale(1, 1)
		FillGrad.Color = ColorSequence.new(Color3.fromRGB(70, 176, 40), GREEN)
		Status.Text = "Ready to give pieces!"
		Status.TextColor3 = GREEN
		bigBurst()

		Flash.BackgroundTransparency = 0.3
		TweenService:Create(Flash, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()

		task.delay(0.8, function()
			TweenService:Create(Cover, TweenInfo.new(0.6), { BackgroundTransparency = 0 }):Play()
			task.wait(0.65)
			Gui:Destroy()

			-- ===== PUT YOUR MAIN SCRIPT BELOW THIS LINE =====

		end)
	end
end)
