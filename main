	BackgroundTransparency = 0.84,
	BorderSizePixel = 0,
}, Card)
new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, Ghost)
for _, ex in ipairs({ 4, 10 }) do
	new("Frame", { Position = UDim2.fromOffset(ex, 7), Size = UDim2.fromOffset(3, 4), BackgroundColor3 = DARK, BackgroundTransparency = 0.4, BorderSizePixel = 0 }, Ghost)
end

-- ========== PICTURE RING ==========
local CX, CY = CARD_W / 2, 92
local Halo = circle(Card, 156, CX, CY, 0.9, ORANGE)
local RingFrame = circle(Card, 132, CX, CY, 0, INNER)
local RingStroke = new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 4 }, RingFrame)
local RingGrad = new("UIGradient", {
	Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, ORANGE),
		ColorSequenceKeypoint.new(0.5, PURPLE),
		ColorSequenceKeypoint.new(1, ORANGE),
	}),
}, RingStroke)

local Art = new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromOffset(CX, CY),
	Size = UDim2.fromOffset(96, 96),
	BackgroundTransparency = 1,
	ZIndex = 2,
}, Card)
local PicScale = new("UIScale", {}, Art)
local slides = {}
local SLIDE_COUNT = (#IMAGE_IDS > 0) and #IMAGE_IDS or #PICS

local function buildSlide(i)
	if slides[i] then
		return slides[i]
	end
	local holder
	if #IMAGE_IDS > 0 then
		holder = new("ImageLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Image = IMAGE_IDS[i],
			ScaleType = Enum.ScaleType.Fit,
			Visible = false,
		}, Art)
	else
		local dims, pal, runs = PICS[i]:match("^([^|]*)|([^|]*)|(.*)$")
		local gw, gh = dims:match("(%d+),(%d+)")
		gw, gh = tonumber(gw), tonumber(gh)
		holder = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(gw * CELL, gh * CELL),
			BackgroundTransparency = 1,
			Visible = false,
		}, Art)
		local colors = {}
		for hex in pal:gmatch("[^,]+") do
			colors[#colors + 1] = Color3.fromRGB(
				tonumber(hex:sub(1, 2), 16),
				tonumber(hex:sub(3, 4), 16),
				tonumber(hex:sub(5, 6), 16)
			)
		end
		for y, x, w, c in runs:gmatch("(%d+),(%d+),(%d+),(%d+)") do
			new("Frame", {
				Position = UDim2.fromOffset(tonumber(x) * CELL, tonumber(y) * CELL),
				Size = UDim2.fromOffset(tonumber(w) * CELL + 1, CELL + 1),
				BackgroundColor3 = colors[tonumber(c) + 1],
				BorderSizePixel = 0,
			}, holder)
		end
	end
	slides[i] = holder
	return holder
end

-- little lights orbiting the ring
local orbs = {}
for k = 1, 4 do
	local o = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(5, 5),
		BackgroundColor3 = (k % 2 == 0) and PURPLE or ORANGE_LIGHT,
		BorderSizePixel = 0,
		ZIndex = 3,
	}, Card)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, o)
	orbs[k] = o
end

-- confetti
local confetti = {}
local palette = { ORANGE, PURPLE, YELLOW, GREEN }
for i = 1, 36 do
	local size = (i % 3 == 0) and 5 or 4
	confetti[i] = {
		alive = false,
		frame = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = palette[(i % #palette) + 1],
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = 6,
		}, Card),
	}
end
local function launch(p, x, y, vx, vy, life)
	p.alive, p.t, p.x, p.y, p.vx, p.vy, p.max = true, 0, x, y, vx, vy, life
	p.rot = rnd:NextNumber(0, 360)
	p.frame.Visible = true
end
local function miniBurst()
	local made = 0
	for _, p in ipairs(confetti) do
		if not p.alive then
			local a = rnd:NextNumber(0, math.pi * 2)
			local sp = rnd:NextNumber(55, 105)
			launch(p, CX, CY, math.cos(a) * sp, math.sin(a) * sp, rnd:NextNumber(0.45, 0.8))
			made = made + 1
			if made >= 8 then
				return
			end
		end
	end
end
local function bigBurst()
	for _, p in ipairs(confetti) do
		local a = rnd:NextNumber(0, math.pi * 2)
		local sp = rnd:NextNumber(70, 160)
		launch(p, CX, CY, math.cos(a) * sp, math.sin(a) * sp, rnd:NextNumber(0.7, 1.2))
	end
end

-- what happens every time the picture changes
local currentSlide, haloFlash = 0, 0
local function showSlide(i)
	if slides[currentSlide] then
		slides[currentSlide].Visible = false
	end
	currentSlide = i
	buildSlide(i).Visible = true
	PicScale.Scale = 0.55
	TweenService:Create(PicScale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	RingStroke.Thickness = 7
	TweenService:Create(RingStroke, TweenInfo.new(0.3), { Thickness = 4 }):Play()
	Halo.BackgroundColor3 = HUES[((i - 1) % #HUES) + 1]
	haloFlash = 1
	miniBurst()
end
showSlide(1)

