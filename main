local function pumpkin(x, y, parentFrame, w, h)
	local p = new("Frame", {
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = ORANGE,
		BorderSizePixel = 0,
	}, parentFrame)
	new("UICorner", { CornerRadius = UDim.new(0.45, 0) }, p)
	new("UIStroke", { Color = ORANGE_DARK, Thickness = 1 }, p)
	new("Frame", { Position = UDim2.fromOffset(w / 2 - 1, -3), Size = UDim2.fromOffset(3, 4), BackgroundColor3 = GREEN, BorderSizePixel = 0 }, p)
	new("Frame", { Position = UDim2.fromOffset(w * 0.2, h * 0.3), Size = UDim2.fromOffset(3, 3), BackgroundColor3 = DARK, BorderSizePixel = 0 }, p)
	new("Frame", { Position = UDim2.fromOffset(w * 0.62, h * 0.3), Size = UDim2.fromOffset(3, 3), BackgroundColor3 = DARK, BorderSizePixel = 0 }, p)
	new("Frame", { Position = UDim2.fromOffset(w * 0.25, h * 0.68), Size = UDim2.fromOffset(w * 0.5, 2), BackgroundColor3 = DARK, BorderSizePixel = 0 }, p)
	return p
end
