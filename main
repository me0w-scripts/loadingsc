	Size = UDim2.new(1, 0, 0, 80),
	BackgroundColor3 = Color3.new(1, 1, 1),
	BorderSizePixel = 0,
}, Card)
new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0.92, 1) }, Sheen)

-- cobweb in the top-left corner
local function webLine(x, y, len, rot)
	new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(len, 1),
		Rotation = rot,
		BackgroundColor3 = Color3.fromRGB(200, 190, 230),
		BackgroundTransparency = 0.65,
		BorderSizePixel = 0,
	}, Card)
end
for _, a in ipairs({ 10, 35, 60, 85 }) do
	local r = math.rad(a)
	webLine(math.cos(r) * 36, math.sin(r) * 36, 72, a)
end
for _, rad in ipairs({ 26, 48 }) do
	for a = 5, 80, 15 do
		local m = math.rad(a + 7.5)
		webLine(math.cos(m) * rad, math.sin(m) * rad, rad * 0.27, a + 7.5 + 90)
	end
end

